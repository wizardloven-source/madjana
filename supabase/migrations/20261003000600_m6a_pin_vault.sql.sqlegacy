-- ============================================================================
-- M6a (Vault variant): PIN v2 + record_login_success, salt from Supabase Vault
-- ============================================================================
-- WHY
--   Supabase forbids ALTER DATABASE/ROLE SET app.pin_secret ("permission
--   denied"), so the GUC-based M6a cannot be configured there. This variant
--   reads the salt from Supabase Vault instead:
--
--       SELECT decrypted_secret FROM vault.decrypted_secrets
--        WHERE name = 'app.pin_secret';
--
--   It is the variant applied to production. The original GUC migration
--   (20261003000600_pin_secret.sql) stays for self-hosted boxes that CAN set
--   app.pin_secret; both are idempotent and may coexist.
--
-- SCOPE
--   * replaces public.app_password_from_pin_v2(text)  -> reads Vault
--   * replaces public.record_login_success(uuid,text) -> validates the PIN
--   * no GUC, no ALTER ROLE/DATABASE, no user data modified
--
-- SECURITY NOTES
--   * app_password_from_pin_v2 is STABLE SECURITY DEFINER, search_path pinned,
--     and REVOKEd from PUBLIC, anon AND authenticated -- it is a PIN oracle.
--   * record_login_success is granted to authenticated ONLY; REVOKEd from
--     PUBLIC and anon (also a PIN oracle).
--   * the secret itself never appears in this file or the repo.
--   * the PUBLIC-exposure assertion uses aclexplode(grantee = 0), NOT
--     has_function_privilege('PUBLIC', ...) which raises 42704 because PUBLIC
--     is a pseudo-grantee, not a role. See 20261003001950_m6ab_acl_verification.
--
-- IDEMPOTENT. RE-RUN SAFE.
-- ============================================================================

BEGIN;

-- ── 1) v2 derivation from the Vault secret ──────────────────────────────────
CREATE OR REPLACE FUNCTION public.app_password_from_pin_v2(p_pin text)
RETURNS text
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path = public, pg_temp
AS $m6a_v2$
DECLARE
    v_secret text;
BEGIN
    IF p_pin IS NULL OR p_pin !~ '^[0-9]{4}$' THEN
        RAISE EXCEPTION 'PIN_FORMAT_INVALID: PIN must be 4 digits';
    END IF;

    SELECT decrypted_secret
      INTO v_secret
      FROM vault.decrypted_secrets
     WHERE name = 'app.pin_secret'
     LIMIT 1;

    IF v_secret IS NULL OR v_secret = '' THEN
        RAISE EXCEPTION 'PIN_SECRET_NOT_CONFIGURED: app.pin_secret missing from vault.decrypted_secrets';
    END IF;

    RETURN 'madjana$' || p_pin || '$' || v_secret;
END;
$m6a_v2$;

REVOKE EXECUTE ON FUNCTION public.app_password_from_pin_v2(text) FROM PUBLIC;
REVOKE EXECUTE ON FUNCTION public.app_password_from_pin_v2(text) FROM anon;
REVOKE EXECUTE ON FUNCTION public.app_password_from_pin_v2(text) FROM authenticated;

-- ── 2) record_login_success validates the PIN it is given ───────────────────
DROP FUNCTION IF EXISTS public.record_login_success(uuid, text);
DROP FUNCTION IF EXISTS public.record_login_success(uuid);

CREATE OR REPLACE FUNCTION public.record_login_success(p_uid uuid, p_pin text)
RETURNS void
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public, pg_temp
AS $m6a_rls$
DECLARE
    v_enc text;
    v_v2  text;
BEGIN
    IF p_uid IS NULL THEN
        RAISE EXCEPTION 'AUTHORIZATION_DENIED: invalid user context';
    END IF;
    IF p_pin IS NULL OR p_pin !~ '^[0-9]{4}$' THEN
        RAISE EXCEPTION 'PIN_FORMAT_INVALID: PIN must be 4 digits';
    END IF;

    v_v2 := public.app_password_from_pin_v2(p_pin);

    SELECT pin_hash
      INTO v_enc
      FROM public.users
     WHERE id = p_uid
       AND is_active = true;

    IF v_enc IS NULL OR v_enc = '' THEN
        RAISE EXCEPTION 'AUTHORIZATION_DENIED: no PIN hash for this account';
    END IF;

    IF extensions.crypt(v_v2, v_enc) <> v_enc THEN
        RAISE EXCEPTION 'INVALID_CREDENTIALS: bad PIN';
    END IF;

    UPDATE public.users
       SET failed_attempts = 0,
           locked_until    = NULL,
           updated_at      = NOW()
     WHERE id = p_uid
       AND is_active = true;
END;
$m6a_rls$;

REVOKE EXECUTE ON FUNCTION public.record_login_success(uuid, text) FROM PUBLIC;
REVOKE EXECUTE ON FUNCTION public.record_login_success(uuid, text) FROM anon;
GRANT  EXECUTE ON FUNCTION public.record_login_success(uuid, text) TO authenticated;

COMMIT;

-- ============================================================================
-- VERIFICATION (after COMMIT: a failure here never rolls the work back)
-- ============================================================================
DO $m6a_chk$
DECLARE
    v_n   int;
    v_sig text;
BEGIN
    -- v2 derivation: right shape, right volatility, right security
    SELECT count(*) INTO v_n
      FROM pg_proc p
      JOIN pg_namespace n ON n.oid = p.pronamespace
     WHERE n.nspname = 'public'
       AND p.proname = 'app_password_from_pin_v2'
       AND p.prokind = 'f'
       AND p.pronargs = 1
       AND format_type(p.proargtypes[0], NULL) = 'text'
       AND p.provolatile = 's'
       AND p.prosecdef;
    IF v_n <> 1 THEN
        RAISE EXCEPTION 'FAIL: app_password_from_pin_v2 not STABLE SECURITY DEFINER';
    END IF;

    IF EXISTS (
        SELECT 1 FROM pg_proc p
         JOIN pg_namespace n ON n.oid = p.pronamespace
        WHERE n.nspname = 'public'
          AND p.proname = 'app_password_from_pin_v2'
          AND p.prokind = 'f'
          AND p.proconfig IS DISTINCT FROM ARRAY['search_path=public, pg_temp']
    ) THEN
        RAISE EXCEPTION 'FAIL: app_password_from_pin_v2 search_path not pinned';
    END IF;

    -- the PIN oracle must not leak to an API role or PUBLIC (grantee 0)
    IF has_function_privilege('anon', 'public.app_password_from_pin_v2(text)', 'EXECUTE')
       OR has_function_privilege('authenticated', 'public.app_password_from_pin_v2(text)', 'EXECUTE') THEN
        RAISE EXCEPTION 'FAIL: app_password_from_pin_v2 leaked to an API role';
    END IF;
    IF EXISTS (
        SELECT 1 FROM pg_proc p
         CROSS JOIN LATERAL aclexplode(COALESCE(p.proacl, acldefault('f', p.proowner))) a
        WHERE p.oid = to_regprocedure('public.app_password_from_pin_v2(text)')
          AND a.grantee = 0 AND a.privilege_type = 'EXECUTE'
    ) THEN
        RAISE EXCEPTION 'FAIL: app_password_from_pin_v2 grants EXECUTE to PUBLIC (grantee 0)';
    END IF;

    -- record_login_success(uuid,text) only; old one-arg form removed
    SELECT count(*) INTO v_n FROM pg_proc p
     JOIN pg_namespace n ON n.oid = p.pronamespace
    WHERE n.nspname = 'public' AND p.proname = 'record_login_success' AND p.pronargs = 2;
    IF v_n <> 1 THEN
        RAISE EXCEPTION 'FAIL: record_login_success(uuid,text) not installed';
    END IF;
    SELECT count(*) INTO v_n FROM pg_proc p
     JOIN pg_namespace n ON n.oid = p.pronamespace
    WHERE n.nspname = 'public' AND p.proname = 'record_login_success' AND p.pronargs = 1;
    IF v_n <> 0 THEN
        RAISE EXCEPTION 'FAIL: record_login_success(uuid) still present';
    END IF;

    IF NOT has_function_privilege('authenticated', 'public.record_login_success(uuid, text)', 'EXECUTE') THEN
        RAISE EXCEPTION 'FAIL: authenticated lost EXECUTE on record_login_success';
    END IF;
    IF has_function_privilege('anon', 'public.record_login_success(uuid, text)', 'EXECUTE') THEN
        RAISE EXCEPTION 'FAIL: anon can call record_login_success (PIN oracle)';
    END IF;

    RAISE NOTICE 'OK: M6a (Vault) verified - v2 reads vault.decrypted_secrets, record_login_success(uuid,text) locked down';
END;
$m6a_chk$;
